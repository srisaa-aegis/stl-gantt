{
  "name": "stl-gantt",
  "version": "0.1.0",
  "description": "A dependency-free TypeScript Gantt chart: working calendar, dependency scheduling (FS/SS/FF/SF with lag) and critical path in a pure core, plus a DOM renderer.",
  "license": "MIT",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "scheduling",
    "critical-path",
    "typescript",
    "timeline"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "src/style.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "demo": "node scripts/build-demo.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  },
  "author": "Srisaa Technologies (OPC) Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srisaa-aegis/stl-gantt.git"
  },
  "bugs": {
    "url": "https://github.com/srisaa-aegis/stl-gantt/issues"
  },
  "homepage": "https://github.com/srisaa-aegis/stl-gantt#readme",
  "engines": {
    "node": ">=18"
  }
}
